# Keystore for release signing.
#
# Copy to app/keystore.properties and fill in. Never commit the filled-in
# file or the .jks it points at — app/keystore.properties is gitignored for
# that reason.
#
# Generate the key once:
#
#   keytool -genkeypair -v \
#     -keystore app/s3bypass-release.jks \
#     -alias s3bypass \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Back the .jks up somewhere you will still have in five years, and keep the
# passwords in a password manager. This is the one free step that can cost
# real money: Android refuses to update an installed app signed with a
# different key, so losing it means every user uninstalls by hand and loses
# their profiles and settings. There is no recovery.
storeFile=s3bypass-release.jks
storePassword=CHANGE_ME
keyAlias=s3bypass
keyPassword=CHANGE_ME
